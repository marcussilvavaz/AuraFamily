<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_family_list_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/omni_widget_bg"
    android:orientation="vertical"
    android:padding="10dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/widget_family_list_header_click"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_family_list_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🛒 Lista &amp; Mural da Família"
                android:textColor="@color/widget_text_primary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_family_list_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Toque nos itens para marcar"
                android:textColor="@color/widget_text_secondary"
                android:textSize="10sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_family_list_btn_add"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:background="@drawable/omni_widget_accent_pill"
            android:gravity="center"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="+ Item"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Scrollable Checklist ListView -->
    <ListView
        android:id="@+id/widget_family_list_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:divider="@null"
        android:dividerHeight="0dp" />

    <TextView
        android:id="@+id/widget_family_list_empty_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:background="@drawable/omni_widget_card_bg"
        android:gravity="center"
        android:padding="12dp"
        android:text="Lista da família vazia.\nToque em + Item para adicionar."
        android:textColor="@color/widget_text_secondary"
        android:textSize="11sp"
        android:visibility="gone" />

</LinearLayout>
