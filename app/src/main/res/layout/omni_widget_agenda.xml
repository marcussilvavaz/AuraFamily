<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_agenda_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/omni_widget_bg"
    android:orientation="vertical"
    android:padding="10dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widget_agenda_logo"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="@string/app_name"
            android:src="@drawable/ic_omni_symbol" />

        <LinearLayout
            android:id="@+id/widget_agenda_header_click"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_agenda_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📅 Agenda de Hoje"
                android:textColor="@color/widget_text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_agenda_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Toque para concluir"
                android:textColor="@color/widget_text_secondary"
                android:textSize="10sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_agenda_btn_voice"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/omni_widget_subtle_pill"
            android:gravity="center"
            android:text="🎙️"
            android:textColor="@color/widget_accent_blue"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/widget_agenda_btn_add"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/omni_widget_accent_pill"
            android:gravity="center"
            android:text="+"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_agenda_btn_refresh"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/omni_widget_card_bg"
            android:gravity="center"
            android:text="↻"
            android:textColor="@color/widget_text_secondary"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Scrollable ListView of all today's personal and family tasks -->
    <ListView
        android:id="@+id/widget_agenda_list_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:divider="@null"
        android:dividerHeight="0dp" />

    <TextView
        android:id="@+id/widget_agenda_empty_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:background="@drawable/omni_widget_card_bg"
        android:gravity="center"
        android:padding="12dp"
        android:text="Nenhuma tarefa agendada para hoje.\nToque em + para adicionar."
        android:textColor="@color/widget_text_secondary"
        android:textSize="11sp"
        android:visibility="gone" />

</LinearLayout>
