<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_glucose_only_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/omni_widget_bg"
    android:orientation="vertical"
    android:padding="10dp">

    <!-- Row 1: Header + Last Reading + Floating Quick Measure Button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/widget_glucose_header_click"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_glucose_main_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🩸 Monitoramento de Glicemia"
                android:textColor="@color/widget_text_primary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_glucose_last_reading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Última: -- mg/dL"
                android:textColor="@color/widget_accent_blue"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_glucose_btn_quick_measure"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:background="@drawable/omni_widget_accent_pill"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="🩸 Medir"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Row 2A & 2B: 6 Official Period Selector Chips (opens Floating Dialog pre-selected) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_slot_btn_jejum"
            android:layout_width="0dp"
            android:layout_height="22dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/omni_widget_card_bg"
            android:gravity="center"
            android:text="Jejum"
            android:textColor="@color/widget_text_primary"
            android:textSize="9.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_slot_btn_1h_cafe"
            android:layout_width="0dp"
            android:layout_height="22dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/omni_widget_card_bg"
            android:gravity="center"
            android:text="1h Pós-Café"
            android:textColor="@color/widget_text_primary"
            android:textSize="9.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_slot_btn_almoco"
            android:layout_width="0dp"
            android:layout_height="22dp"
            android:layout_weight="1"
            android:background="@drawable/omni_widget_card_bg"
            android:gravity="center"
            android:text="Almoço"
            android:textColor="@color/widget_text_primary"
            android:textSize="9.5sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_slot_btn_1h_almoco"
            android:layout_width="0dp"
            android:layout_height="22dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/omni_widget_card_bg"
            android:gravity="center"
            android:text="1h Pós-Almoço"
            android:textColor="@color/widget_text_primary"
            android:textSize="9.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_slot_btn_janta"
            android:layout_width="0dp"
            android:layout_height="22dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/omni_widget_card_bg"
            android:gravity="center"
            android:text="Janta"
            android:textColor="@color/widget_text_primary"
            android:textSize="9.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_slot_btn_1h_janta"
            android:layout_width="0dp"
            android:layout_height="22dp"
            android:layout_weight="1"
            android:background="@drawable/omni_widget_card_bg"
            android:gravity="center"
            android:text="1h Pós-Janta"
            android:textColor="@color/widget_text_primary"
            android:textSize="9.5sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Row 3: Post-Meal Countdown Timer Controls -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/omni_widget_card_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="7dp">

        <TextView
            android:id="@+id/widget_glucose_timer_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="⏱️ Pós-Refeição"
            android:textColor="@color/widget_text_secondary"
            android:textSize="11sp"
            android:textStyle="bold" />

        <Chronometer
            android:id="@+id/widget_glucose_only_chronometer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:countDown="true"
            android:textColor="@color/widget_accent_blue"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/widget_glucose_only_static_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:text="01:00:00"
            android:textColor="@color/widget_accent_blue"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_glucose_only_btn_toggle"
            android:layout_width="wrap_content"
            android:layout_height="26dp"
            android:background="@drawable/omni_widget_subtle_pill"
            android:gravity="center"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="▶ 1h"
            android:textColor="@color/widget_accent_blue"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_glucose_only_btn_reset"
            android:layout_width="wrap_content"
            android:layout_height="26dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/omni_widget_card_bg"
            android:gravity="center"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="↺"
            android:textColor="@color/widget_text_secondary"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
