<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_finance_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/omni_widget_bg"
    android:orientation="vertical"
    android:padding="10dp">

    <!-- Header: Balance + Privacy Eye Toggle + "+ Gasto" -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/widget_finance_header_click"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_finance_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="💳 Finanças &amp; Contas"
                android:textColor="@color/widget_text_secondary"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_finance_total_balance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="R$ 0,00"
                android:textColor="@color/widget_text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Eye Toggle Button to mask/unmask values -->
        <TextView
            android:id="@+id/widget_finance_btn_eye"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginEnd="5dp"
            android:background="@drawable/omni_widget_card_bg"
            android:gravity="center"
            android:text="👁️"
            android:textColor="@color/widget_text_primary"
            android:textSize="13sp" />

        <!-- Quick "+ Gasto" button -->
        <TextView
            android:id="@+id/widget_finance_btn_add_tx"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:background="@drawable/omni_widget_accent_pill"
            android:gravity="center"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="+ Gasto"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Scrollable ListView of all Bank Accounts & Credit Cards with balance/limit progress bar -->
    <ListView
        android:id="@+id/widget_finance_list_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:divider="@null"
        android:dividerHeight="0dp" />

    <TextView
        android:id="@+id/widget_finance_empty_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:background="@drawable/omni_widget_card_bg"
        android:gravity="center"
        android:padding="12dp"
        android:text="Nenhuma conta cadastrada."
        android:textColor="@color/widget_text_secondary"
        android:textSize="11sp"
        android:visibility="gone" />

</LinearLayout>
